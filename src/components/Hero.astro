---
import { siteConfig } from "../config";
const taglineLink = (siteConfig as any).taglineLink;
---

<!-- Top Bar with Shimmer -->
<div class="w-full h-3 bar-shimmer"></div>

<section
  id="hero"
  class="relative py-16 md:py-20 lg:py-24 overflow-hidden"
  style={`background-color: ${siteConfig.colors.surfaceLight}`}
>
  <!-- Animated DNA background element (subtle) -->
  <svg
    class="dna-bg dna-strand hidden md:block"
    style="top: 8%; right: 4%; width: 180px; height: 360px;"
    viewBox="0 0 100 200"
    fill="none"
    aria-hidden="true"
  >
    <path d="M20 0 Q 50 25 80 50 Q 50 75 20 100 Q 50 125 80 150 Q 50 175 20 200" stroke={siteConfig.colors.primary} stroke-width="1.5"/>
    <path d="M80 0 Q 50 25 20 50 Q 50 75 80 100 Q 50 125 20 150 Q 50 175 80 200" stroke={siteConfig.colors.accent} stroke-width="1.5"/>
    {[0, 25, 50, 75, 100, 125, 150, 175].map((y) => (
      <line x1="20" y1={y} x2="80" y2={y} stroke={siteConfig.colors.primary} stroke-width="1" opacity="0.5"/>
    ))}
  </svg>

  <svg
    class="dna-bg dna-strand hidden lg:block"
    style="bottom: 8%; left: 3%; width: 130px; height: 260px; animation-delay: -2s;"
    viewBox="0 0 100 200"
    fill="none"
    aria-hidden="true"
  >
    <path d="M20 0 Q 50 25 80 50 Q 50 75 20 100 Q 50 125 80 150 Q 50 175 20 200" stroke={siteConfig.colors.accent} stroke-width="1.5"/>
    <path d="M80 0 Q 50 25 20 50 Q 50 75 80 100 Q 50 125 20 150 Q 50 175 80 200" stroke={siteConfig.colors.primary} stroke-width="1.5"/>
    {[0, 25, 50, 75, 100, 125, 150, 175].map((y) => (
      <line x1="20" y1={y} x2="80" y2={y} stroke={siteConfig.colors.accent} stroke-width="1" opacity="0.5"/>
    ))}
  </svg>

  <div class="relative max-w-6xl mx-auto px-6 lg:px-8" style="z-index: 1;">
    <!-- Main Hero Content: 2-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Photo Column -->
      <div class="md:col-span-4 flex justify-center md:justify-start order-2 md:order-1" style="overflow: visible;">
        <div class="relative hero-photo" style="overflow: visible;">
          <!-- Decorative background glow -->
          <div
            class="absolute -inset-4 rounded-2xl"
            style={`background: linear-gradient(135deg, ${siteConfig.colors.primary}15 0%, ${siteConfig.colors.accent}15 100%)`}
          ></div>
          <div class="relative rounded-2xl shadow-2xl overflow-visible" style={`border: 3px solid ${siteConfig.colors.accent};`}>
            <img
              src="/profile.jpg"
              alt={siteConfig.name}
              class="w-56 md:w-64 lg:w-72 rounded-2xl"
              style={`object-fit: contain; object-position: center top; display: block; width: 100%; height: auto;`}
            />
          </div>
        </div>
      </div>

      <!-- Text Content Column -->
      <div class="md:col-span-8 order-1 md:order-2 text-center md:text-left">
        <h1
          class="hero-title text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight"
          style={`color: ${siteConfig.accentColor};`}
        >
          {siteConfig.name}
        </h1>

        <!-- Separator bar -->
        <div
          class="w-24 h-1.5 my-4 mx-auto md:mx-0 rounded-full"
          style={`background-color: ${siteConfig.colors.accent}`}
        ></div>

        <!-- Title (subtitle) -->
        <p
          class="hero-subtitle text-lg md:text-xl font-medium mb-6"
          style={`color: ${siteConfig.colors.primary};`}
        >
          {siteConfig.title}
        </p>

        <!-- Highlight tagline (linked to manuscript) -->
        {siteConfig.tagline && (
          <p
            class="hero-description text-base md:text-lg text-gray-700 leading-relaxed mb-8 max-w-xl mx-auto md:mx-0"
          >
            {taglineLink ? (
              <a
                href={taglineLink}
                target="_blank"
                rel="noopener noreferrer"
                class="link-underline"
                style={`color: ${siteConfig.colors.primary};`}
              >
                {siteConfig.tagline}
              </a>
            ) : (
              siteConfig.tagline
            )}
          </p>
        )}

        <!-- CTA Button + visible email -->
        <div class="hero-cta flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5 justify-center md:justify-start mb-6">
          <a
            href={`mailto:${siteConfig.social?.email}?subject=${siteConfig.cta?.emailSubject || 'Contact'}`}
            class="btn-hover inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full text-white font-semibold text-lg shadow-lg"
            style={`background-color: ${siteConfig.colors.accent}`}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            {siteConfig.cta?.buttonText || "Get in Touch"}
          </a>
          {siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="text-sm md:text-base font-medium link-underline"
              style={`color: ${siteConfig.accentColor};`}
            >
              {siteConfig.social.email}
            </a>
          )}
        </div>

        <!-- Social Links -->
        <div class="hero-social flex gap-3 justify-center md:justify-start">
          {siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="icon-hover w-11 h-11 rounded-full flex items-center justify-center"
              style={`background-color: ${siteConfig.accentColor}; color: white`}
              aria-label="Email"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </a>
          )}
          {siteConfig.social?.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-hover w-11 h-11 rounded-full flex items-center justify-center"
              style={`background-color: ${siteConfig.accentColor}; color: white`}
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {(siteConfig as any).social?.scholar && (
            <a
              href={(siteConfig as any).social.scholar}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-hover w-11 h-11 rounded-full flex items-center justify-center"
              style={`background-color: ${siteConfig.accentColor}; color: white`}
              aria-label="Google Scholar"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 100 14 7 7 0 000-14z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Stats / Trust Bar -->
    {siteConfig.stats && siteConfig.stats.length > 0 && (
      <div
        class="hero-stats mt-16 py-6 px-8 rounded-2xl grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8"
        style={`background-color: ${siteConfig.colors.primaryDark}08; border: 1px solid ${siteConfig.colors.primaryDark}15`}
      >
        {siteConfig.stats.map((stat, index) => (
          <div class={`text-center stat-number`}>
            <div
              class="text-2xl md:text-3xl font-bold"
              style={`color: ${siteConfig.colors.accent}`}
            >{stat.value}</div>
            <div class="text-xs md:text-sm text-gray-600 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<!-- Bottom Bar with Shimmer -->
<div class="w-full h-3 bar-shimmer"></div>
