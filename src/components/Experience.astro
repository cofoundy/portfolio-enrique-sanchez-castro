---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const community = ((siteConfig as any).community || []) as Array<{title: string; org: string; period: string; description: string}>;
const hasCommunity = community.length > 0;
---

{(hasExperience || hasCommunity) && (
  <section
    id="outreach"
    class="py-12 md:py-16"
    style={`background-color: ${siteConfig.colors.surfaceLight}`}
  >
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <!-- Master Header -->
      <div class="mb-10 reveal-left">
        <h2
          class="text-3xl md:text-4xl font-semibold"
          style={`color: ${siteConfig.accentColor};`}
        >
          Outreach & Leadership
        </h2>
        <div
          class="w-16 h-1 mt-3 rounded-full"
          style={`background-color: ${siteConfig.colors.accent}`}
        ></div>
      </div>

      <!-- Subsection: Leadership -->
      {hasExperience && (
        <div class="mb-12">
          <h3
            class="text-xl md:text-2xl font-semibold mb-6"
            style={`color: ${siteConfig.accentColor};`}
          >
            Leadership
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            {siteConfig.experience.map((exp, index) => (
              <div
                class={`reveal stagger-${Math.min(index + 1, 6)} card-hover p-5 rounded-xl`}
                style={`background-color: white; border: 1px solid ${siteConfig.colors.primary}20`}
              >
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h4
                      class="text-lg font-semibold"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {exp.title}
                    </h4>
                    <p
                      class="text-base font-medium"
                      style={`color: ${siteConfig.colors.accent}`}
                    >
                      {exp.company}
                    </p>
                  </div>
                  <span
                    class="text-xs px-3 py-1 rounded-full flex-shrink-0"
                    style={`background-color: ${siteConfig.colors.surface}; color: ${siteConfig.colors.primary}`}
                  >
                    {exp.dateRange}
                  </span>
                </div>
                <ul class="space-y-1.5">
                  {exp.bullets.slice(0, 3).map((bullet) => (
                    <li class="flex items-start text-sm text-gray-600">
                      <span
                        class="inline-block w-1.5 h-1.5 rounded-full mt-1.5 mr-2 flex-shrink-0"
                        style={`background-color: ${siteConfig.colors.accent}`}
                      />
                      <span><Fragment set:html={bullet} /></span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Subsection: Community & Outreach -->
      {hasCommunity && (
        <div>
          <h3
            class="text-xl md:text-2xl font-semibold mb-6"
            style={`color: ${siteConfig.accentColor};`}
          >
            Community & Outreach
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            {community.map((item, index) => (
              <div
                class={`reveal stagger-${Math.min(index + 1, 6)} card-hover p-5 rounded-xl flex gap-4`}
                style={`background-color: white; border: 1px solid ${siteConfig.colors.primary}15`}
              >
                <div
                  class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0"
                  style={`background-color: ${siteConfig.colors.accent}15`}
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    style={`color: ${siteConfig.colors.accent}`}
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4
                    class="text-base font-semibold"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    {item.title}
                  </h4>
                  <p
                    class="text-sm font-medium"
                    style={`color: ${siteConfig.colors.accent}`}
                  >
                    {item.org} · {item.period}
                  </p>
                  <p class="text-sm text-gray-600 mt-1">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}
